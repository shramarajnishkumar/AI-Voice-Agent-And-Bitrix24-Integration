# ==========================================
# Production AI Voice Agent Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database (PostgreSQL or auto-fallback to SQLite)
# Example Postgres: postgresql+asyncpg://postgres:password@localhost:5432/voice_agent_db
# Example SQLite: sqlite+aiosqlite:///./data/voice_agent.db
DATABASE_URL=sqlite+aiosqlite:///./data/voice_agent.db

# Bitrix24 Inbound Webhook REST API
# Format: https://<your-domain>.bitrix24.com/rest/<user_id>/<webhook_code>/
# If left empty or "demo", system activates intelligent Mock Mode with full CRM payload inspection!
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/your_webhook_token/
BITRIX24_DEFAULT_ASSIGNED_BY_ID=1

# Telephony - Twilio Credentials (Optional for local simulator, required for live phone number)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_for_demo
TWILIO_AUTH_TOKEN=dummy_auth_token_for_demo
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_SPEECH_LANGUAGE=auto
TWILIO_SPEECH_TIMEOUT=auto
TWILIO_SPEECH_MODEL=experimental_conversations
TWILIO_GATHER_TIMEOUT=6
LLM_TURN_TIMEOUT=1.2
PUBLIC_BASE_URL=http://localhost:8000

# NLP & AI Extraction Settings
# Provider options: "openai" (recommended), "heuristic" (zero-dependency regex/NLP), "ollama" (local open-source)
NLP_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voice Prompts & Intake Questions
AGENT_NAME="Aura"
COMPANY_NAME="CloudSolutions AI"
QUESTION_1="Hello, thank you for calling CloudSolutions! To direct you properly, may I please know your name and your company name?"
QUESTION_2="Thank you! What specific service or technical solution are you looking for today?"
QUESTION_3="Got it. What is the best contact phone number or email address for our team to follow up with you?"
CLOSING_MESSAGE="Thank you so much! I have registered your inquiry into our CRM system, and our specialist will be in touch shortly. Have a wonderful day!"
